{
  "name": "shopify-theme-vite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "audit": "yarn npm audit --severity moderate --all",
    "dev": "concurrently -k -n VITE,SHOPIFY -c blue,green \"vite\" \"shopify theme dev\"",
    "dev:vite": "vite",
    "build": "vite build",
    "build:verify": "yarn build && node scripts/verify-assets.ts",
    "check:entrypoints": "vitest run utils/entrypoints.test.ts",
    "check:sass": "vitest run utils/sass-validation.test.ts",
    "check:theme": "shopify theme check",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:types:coverage": "type-coverage --project tsconfig.json --strict --at-least 100 --report-unused-ignore && type-coverage --project tsconfig.node.json --strict --at-least 100 --report-unused-ignore",
    "clean": "rimraf node_modules .vite dist .shopify/.cache assets/.vite .eslintcache .stylelintcache tsconfig.tsbuildinfo tsconfig.node.tsbuildinfo",
    "clean:build": "rimraf dist .vite assets/.vite",
    "fresh": "yarn clean && yarn install && yarn build:verify",
    "format": "prettier --write \"frontend/**/*.{js,jsx,ts,tsx,mts,scss,css,json,md}\" \"{scripts,utils}/**/*.ts\" \"*.{js,json,md}\"",
    "lint": "yarn lint:scss && yarn lint:js",
    "lint:fix": "yarn lint:scss --fix && yarn lint:js --fix",
    "lint:js": "eslint \"frontend/**/*.{js,jsx,ts,tsx,mts}\" \"{scripts,utils}/**/*.ts\" eslint.config.js --cache",
    "lint:scss": "stylelint \"frontend/styles/**/*.scss\" --cache",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@driver-digital/vite-plugin-shopify-clean": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.103.1",
    "sharp": "^0.35.4",
    "stylelint": "^17.14.1",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "svgo": "^4.1.0",
    "type-coverage": "^2.30.1",
    "typescript": "^5.0.0",
    "vite": "8.2.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-shopify": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "lint-staged": {
    "frontend/styles/**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "utils/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "scripts/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697"
}
